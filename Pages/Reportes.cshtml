@page
@model Chef_Board_Desafio3.Pages.ReportesModel
@{
    ViewData["Title"] = "Reportes ChefBoard";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="@Url.Content("~/css/reportes.css")" />
</head>
<body>
    <main>
        <header class="page-header">
            <div>
                <h1>Reportes ChefBoard</h1>
                <p class="subtitle">Consulte los informes disponibles.</p>
            </div>

            <form method="post" action="/Reportes?handler=Logout">
                @Html.AntiForgeryToken()
                <button class="logout-button" type="submit">Cerrar sesión</button>
            </form>
        </header>

        <section class="panel" aria-label="Filtros de reportes">
            <form class="filters" method="get">
                <div class="field field-report">
                    <label for="report">Reporte</label>
                    <select id="report" name="SelectedReportKey" onchange="this.form.submit()">
                        <option value="RecipesIngredients" selected="@(Model.SelectedReportKey == "RecipesIngredients")">Recetas e ingredientes</option>
                        <option value="PreparationSteps" selected="@(Model.SelectedReportKey == "PreparationSteps")">Pasos de preparación</option>
                    </select>
                </div>

                @if (Model.SelectedReportKey == "RecipesIngredients")
                {
                    <div class="field">
                        <label for="tiempo">Tiempo máximo (min)</label>
                        <input type="number" id="tiempo" name="TiempoMaximo" min="1" max="1440" value="@(Model.TiempoMaximo?.ToString() ?? string.Empty)" />
                    </div>
                }

                <button type="submit">Cargar reporte</button>
            </form>
        </section>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="message" role="alert">@Model.ErrorMessage</div>
        }

        @if (!string.IsNullOrEmpty(Model.IframeUrl))
        {
            <section class="panel viewer-panel" aria-label="Visor de reportes">
                <h2 class="viewer-heading">Vista del reporte</h2>
                <nav class="report-links" aria-label="Abrir reporte en otra pestaña">
                    <a href="@Model.ReportUrl" target="_blank" rel="noopener noreferrer">Abrir en SSRS (ReportServer)</a>
                    @if (!string.IsNullOrEmpty(Model.ManagerUrl))
                    {
                        <a href="@Model.ManagerUrl" target="_blank" rel="noopener noreferrer">Abrir en Portal de Informes (Reports)</a>
                    }
                </nav>
                <div id="visor">
                    <iframe src="@Model.IframeUrl" title="Visor SSRS"></iframe>
                </div>
            </section>
        }

        <p class="note">Si el informe no se muestra aquí, puede abrirlo desde el enlace de SSRS.</p>
    </main>
</body>
</html>
