@page
@model Chef_Board_Desafio3.Pages.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar sesión · ChefBoard</title>
    <link rel="stylesheet" href="@Url.Content("~/css/login.css")" />
</head>
<body>
    <main>
        <h1>Iniciar sesión</h1>
        <p>Accede a los reportes de ChefBoard con tu cuenta.</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <p class="error" role="alert">@Model.ErrorMessage</p>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

            <label for="email">Correo electrónico</label>
            <input id="email" name="Email" type="email" autocomplete="username" required value="@Model.Email" />
            @Html.ValidationMessageFor(model => model.Email)

            <label for="password">Contraseña</label>
            <input id="password" name="Password" type="password" autocomplete="current-password" required />
            @Html.ValidationMessageFor(model => model.Password)

            <button type="submit">Entrar</button>
        </form>
    </main>
</body>
</html>
